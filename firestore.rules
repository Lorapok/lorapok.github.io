rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function hasUserRecord() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return hasUserRecord()
        && currentUser().status == "active"
        && currentUser().role == "super-admin";
    }

    function isOwner() {
      return isSuperAdmin() || (
        hasUserRecord()
        && currentUser().status == "active"
        && currentUser().role == "owner"
      );
    }

    function isAccessAdmin() {
      return isOwner() || (
        hasUserRecord()
        && currentUser().status == "active"
        && currentUser().role == "admin"
      );
    }

    function canEditPublishing() {
      return isAccessAdmin() || (
        hasUserRecord()
        && currentUser().status == "active"
        && currentUser().role == "editor"
      );
    }

    function canRunResearch() {
      return isAccessAdmin() || (
        hasUserRecord()
        && currentUser().status == "active"
        && currentUser().role == "researcher"
      );
    }

    function canViewAnalytics() {
      return isAccessAdmin() || (
        hasUserRecord()
        && currentUser().status == "active"
        && currentUser().role == "researcher"
      );
    }

    function canUseDeveloperTools() {
      return isAccessAdmin() || (
        hasUserRecord()
        && currentUser().status == "active"
        && currentUser().role in ["editor", "researcher"]
      );
    }

    function canUseOfficeModule(moduleId) {
      return isAccessAdmin()
        || (
          hasUserRecord()
          && currentUser().status == "active"
          && (
            (
              currentUser().role == "editor"
              && moduleId in ["content", "offers", "feedback", "mail", "chat", "meetings", "tasks"]
            )
            || (
              currentUser().role == "teammate"
              && moduleId in ["content", "feedback", "mail", "chat", "meetings", "tasks"]
            )
          )
        );
    }

    function validManagedRole(role) {
      return role in ["admin", "editor", "researcher", "teammate", "viewer"];
    }

    function validInvitation() {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/office_invites/$(request.auth.token.email))
        && get(/databases/$(database)/documents/office_invites/$(request.auth.token.email)).data.status == "invited";
    }

    function validAccessStatus(status) {
      return status in ["pending", "active", "suspended"];
    }

    function validShortString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validUserCreate(userId) {
      return request.resource.data.keys().hasOnly([
          "uid", "email", "displayName", "photoURL", "role", "status", "lastLogin",
          "department", "title", "activeProvider", "activeModels"
        ])
        && request.resource.data.keys().hasAll([
          "uid", "email", "displayName", "photoURL", "role", "status", "lastLogin"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && validShortString(request.resource.data.email, 254)
        && validShortString(request.resource.data.displayName, 120)
        && validShortString(request.resource.data.photoURL, 2048)
        && validAccessStatus(request.resource.data.status)
        && request.resource.data.lastLogin == request.time
        && (!request.resource.data.keys().hasAny(["department"]) || validShortString(request.resource.data.department, 120))
        && (!request.resource.data.keys().hasAny(["title"]) || validShortString(request.resource.data.title, 120))
        && (!request.resource.data.keys().hasAny(["activeProvider"]) || validShortString(request.resource.data.activeProvider, 40))
        && (!request.resource.data.keys().hasAny(["activeModels"]) || (
          request.resource.data.activeModels is map
          && request.resource.data.activeModels.size() <= 20
        ));
    }

    function ownSafeProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "displayName", "photoURL", "lastLogin", "activeProvider", "activeModels"
      ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && validShortString(request.resource.data.displayName, 120)
        && validShortString(request.resource.data.photoURL, 2048)
        && (!request.resource.data.keys().hasAny(["activeProvider"]) || validShortString(request.resource.data.activeProvider, 40))
        && (!request.resource.data.keys().hasAny(["activeModels"]) || (
          request.resource.data.activeModels is map
          && request.resource.data.activeModels.size() <= 20
        ));
    }

    function adminManagedUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role", "status", "department", "title", "accessUpdatedAt", "accessUpdatedBy"
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && validAccessStatus(request.resource.data.status)
        && (!request.resource.data.keys().hasAny(["department"]) || validShortString(request.resource.data.department, 120))
        && (!request.resource.data.keys().hasAny(["title"]) || validShortString(request.resource.data.title, 120))
        && validShortString(request.resource.data.accessUpdatedBy, 254);
    }

    function adminCanManageTarget() {
      return isSuperAdmin() || (
        isOwner()
        && resource.data.role != "super-admin"
        && request.resource.data.role != "super-admin"
      ) || (
        isAccessAdmin()
        && resource.data.role != "super-admin"
        && resource.data.role != "owner"
        && resource.data.role != "admin"
        && request.resource.data.role != "super-admin"
        && request.resource.data.role != "owner"
        && request.resource.data.role != "admin"
      );
    }

    match /office_projects/{projectId} {
      allow read, write: if canEditPublishing();
    }

    match /sso_apps/{appId} {
      allow get: if resource.data.status == "active" || (hasUserRecord() && currentUser().status == "active");
      allow list: if isAccessAdmin();
      allow create: if isAccessAdmin()
        && request.resource.data.keys().hasOnly([
          "appId", "name", "description", "status", "origins", "createdAt", "updatedAt"
        ])
        && request.resource.data.appId == appId
        && appId.matches("^[a-z0-9][a-z0-9-]{1,62}$")
        && validShortString(request.resource.data.name, 120)
        && validShortString(request.resource.data.description, 500)
        && request.resource.data.status in ["active", "disabled"]
        && request.resource.data.origins is list
        && request.resource.data.origins.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAccessAdmin()
        && request.resource.data.appId == resource.data.appId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "description", "status", "origins", "updatedAt"
        ])
        && validShortString(request.resource.data.name, 120)
        && validShortString(request.resource.data.description, 500)
        && request.resource.data.status in ["active", "disabled"]
        && request.resource.data.origins is list
        && request.resource.data.origins.size() <= 20
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /sso_access/{accessId} {
      allow get: if isAccessAdmin() || (
        signedIn() && accessId.matches("^" + request.auth.uid + "__[a-z0-9][a-z0-9-]{1,62}$")
      );
      allow list: if isAccessAdmin();
      allow create: if isAccessAdmin()
        && request.resource.data.keys().hasOnly([
          "uid", "appId", "status", "scopes", "grantedAt", "grantedBy", "updatedAt", "updatedBy"
        ])
        && accessId == request.resource.data.uid + "__" + request.resource.data.appId
        && request.resource.data.appId.matches("^[a-z0-9][a-z0-9-]{1,62}$")
        && request.resource.data.status in ["active", "revoked"]
        && request.resource.data.scopes is list
        && request.resource.data.scopes.size() <= 30
        && validShortString(request.resource.data.grantedBy, 254)
        && validShortString(request.resource.data.updatedBy, 254)
        && request.resource.data.grantedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAccessAdmin()
        && request.resource.data.keys().hasOnly([
          "uid", "appId", "status", "scopes", "grantedAt", "grantedBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.appId == resource.data.appId
        && request.resource.data.grantedAt == resource.data.grantedAt
        && request.resource.data.grantedBy == resource.data.grantedBy
        && request.resource.data.status in ["active", "revoked"]
        && request.resource.data.scopes is list
        && request.resource.data.scopes.size() <= 30
        && validShortString(request.resource.data.grantedBy, 254)
        && validShortString(request.resource.data.updatedBy, 254)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /published_projects/{projectId} {
      allow read: if true;
      allow write: if canEditPublishing();
    }

    match /office_partners/{partnerId} {
      allow read, write: if canEditPublishing();
    }

    match /published_partners/{partnerId} {
      allow read: if true;
      allow write: if canEditPublishing();
    }

    match /newsletter_subscribers/{subscriptionId} {
      allow create: if request.resource.data.keys().hasOnly([
          "email", "source", "consentVersion", "createdAt", "topics", "userAgent"
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 6
        && request.resource.data.email.size() <= 254
        && subscriptionId == request.resource.data.email
        && !request.resource.data.email.matches(".*[/].*")
        && request.resource.data.email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")
        && request.resource.data.source in ["home_newsletter", "homepage_hero_cro"]
        && request.resource.data.consentVersion == "2026-11"
        && (!request.resource.data.keys().hasAny(["topics"]) || (
          request.resource.data.topics is list
          && request.resource.data.topics.size() >= 1
          && request.resource.data.topics.size() <= 4
        ))
        && (!request.resource.data.keys().hasAny(["userAgent"]) || validShortString(request.resource.data.userAgent, 512))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /agent_config/{documentId} {
      allow read, write: if canRunResearch();
    }

    match /office_modules/{moduleId} {
      allow read, create, update: if canUseOfficeModule(moduleId);
      allow delete: if false;
    }

    match /blog_posts/{postId} {
      allow read: if resource.data.status == "published" || canEditPublishing() || canRunResearch();
      allow write: if canEditPublishing() || canRunResearch();
    }

    match /office_invites/{inviteId} {
      allow read: if isAccessAdmin() || (signedIn() && inviteId == request.auth.token.email);
      allow create: if request.resource.data.email == inviteId
        && request.resource.data.keys().hasOnly([
          "email", "displayName", "role", "status", "department", "title", "invitedBy", "invitedAt"
        ])
        && request.resource.data.status == "invited"
        && validManagedRole(request.resource.data.role)
        && validShortString(request.resource.data.email, 254)
        && validShortString(request.resource.data.displayName, 120)
        && validShortString(request.resource.data.department, 120)
        && validShortString(request.resource.data.title, 120)
        && validShortString(request.resource.data.invitedBy, 254)
        && request.resource.data.invitedAt == request.time
        && (
          isOwner()
          || (isAccessAdmin() && request.resource.data.role != "admin")
        );
      allow update: if (
        request.resource.data.email == resource.data.email
        && request.resource.data.status in ["invited", "revoked"]
        && validManagedRole(request.resource.data.role)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "updatedBy"])
        && validShortString(request.resource.data.updatedBy, 254)
        && (
          isOwner()
          || (
            isAccessAdmin()
            && resource.data.role != "admin"
            && request.resource.data.role != "admin"
          )
        )
      ) || (
        signedIn()
        && inviteId == request.auth.token.email
        && resource.data.status == "invited"
        && request.resource.data.status == "accepted"
        && request.resource.data.acceptedUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "acceptedAt", "acceptedUid"])
      );
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAccessAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && validUserCreate(userId)
        && (
          (
            validInvitation()
            && request.resource.data.role == get(/databases/$(database)/documents/office_invites/$(request.auth.token.email)).data.role
            && request.resource.data.status == "active"
          )
          || (
            request.resource.data.role == "viewer"
            && request.resource.data.status == "pending"
          )
        );
      allow update: if signedIn() && (
        (
          request.auth.uid == userId
          && ownSafeProfileUpdate()
        )
        || (adminCanManageTarget() && adminManagedUserUpdate())
      );
      allow delete: if false;

      match /data/{dataId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAccessAdmin());
      }

      match /chats/{chatId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAccessAdmin());
      }
    }

    match /rbac_audit/{eventId} {
      allow create: if isAccessAdmin()
        && request.resource.data.keys().hasOnly([
          "action", "target", "changes", "actorUid", "actorEmail", "createdAt"
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && validShortString(request.resource.data.action, 80)
        && validShortString(request.resource.data.target, 254)
        && request.resource.data.changes is map
        && request.resource.data.changes.size() <= 10
        && request.resource.data.createdAt == request.time;
      allow read: if isAccessAdmin();
      allow update, delete: if false;
    }

    match /analytics/{eventId} {
      allow create: if hasUserRecord()
        && currentUser().status == "active"
        && request.resource.data.keys().hasOnly([
          "category", "action", "metadata", "uid", "email", "isAnonymous", "timestamp", "platform", "userAgent"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.isAnonymous == false
        && request.resource.data.category in ["auth", "ai", "nav", "config", "system", "profile"]
        && validShortString(request.resource.data.action, 100)
        && request.resource.data.metadata is map
        && request.resource.data.metadata.keys().hasOnly([
          "provider", "success", "model", "error", "tool", "hasKey", "providers"
        ])
        && request.resource.data.metadata.size() <= 8
        && (!request.resource.data.metadata.keys().hasAny(["provider"]) || validShortString(request.resource.data.metadata.provider, 80))
        && (!request.resource.data.metadata.keys().hasAny(["model"]) || validShortString(request.resource.data.metadata.model, 160))
        && (!request.resource.data.metadata.keys().hasAny(["error"]) || validShortString(request.resource.data.metadata.error, 1000))
        && (!request.resource.data.metadata.keys().hasAny(["tool"]) || validShortString(request.resource.data.metadata.tool, 160))
        && (!request.resource.data.metadata.keys().hasAny(["success"]) || request.resource.data.metadata.success is bool)
        && (!request.resource.data.metadata.keys().hasAny(["hasKey"]) || request.resource.data.metadata.hasKey is bool)
        && (!request.resource.data.metadata.keys().hasAny(["providers"]) || (
          request.resource.data.metadata.providers is list
          && request.resource.data.metadata.providers.size() <= 20
        ))
        && request.resource.data.timestamp == request.time
        && validShortString(request.resource.data.platform, 120)
        && validShortString(request.resource.data.userAgent, 512);
      allow read: if canViewAnalytics();
      allow update, delete: if false;
    }

    match /readme_templates/{templateId} {
      allow read, write: if canUseDeveloperTools();
    }

    match /commit_explanations/{explanationId} {
      allow read, write: if canUseDeveloperTools();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
